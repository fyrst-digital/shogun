<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>

        <!-- decorators -->
        <service id="Fyrst\ShogunBundle\Decorator\ThemeFileResolverDecorator" decorates="Shopware\Storefront\Theme\ThemeFileResolver">
            <argument type="service" id="Fyrst\ShogunBundle\Decorator\ThemeFileResolverDecorator.inner"/>
            <argument type="service" id="event_dispatcher"/>
        </service>

        <!-- controllers-->
        <service id="Fyrst\ShogunBundle\Storefront\Controller\NavigationController" public="true">
            <argument type="service" id="Shopware\Core\Content\Category\Service\NavigationLoader"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
            <call method="setTwig">
                <argument type="service" id="twig"/>
            </call>
        </service>

        <!-- twig extensions -->
        <service id="Fyrst\ShogunBundle\Twig\ShIcon" public="true">
            <tag name="twig.extension"/>
        </service>

        <service id="Fyrst\ShogunBundle\Twig\ShMergeDeep" public="true">
            <tag name="twig.extension"/>
        </service>

        <service id="Fyrst\ShogunBundle\Twig\ShUnique" public="true">
            <tag name="twig.extension"/>
        </service>

        <service id="Fyrst\ShogunBundle\Twig\ShValuesLength" public="true">
            <tag name="twig.extension"/>
        </service>

        <service id="Fyrst\ShogunBundle\Twig\ShDefineClasses" public="true">
            <tag name="twig.extension"/>
        </service>
    </services>
</container>