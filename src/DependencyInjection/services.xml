<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>

        <service id="Fyrst\ShogunBundle\Decorator\ThemeFileResolverDecorator" decorates="Shopware\Storefront\Theme\ThemeFileResolver">
            <argument type="service" id="Fyrst\ShogunBundle\Decorator\ThemeFileResolverDecorator.inner"/>
            <argument type="service" id="event_dispatcher"/>
        </service>

        <service id="Fyrst\ShogunBundle\Twig\ShIcon" public="true">
            <tag name="twig.extension"/>
        </service>

        <service id="Fyrst\ShogunBundle\Twig\ShMergeDeep" public="true">
            <tag name="twig.extension"/>
        </service>

        <service id="Fyrst\ShogunBundle\Twig\ShUnique" public="true">
            <tag name="twig.extension"/>
        </service>

        <service id="Fyrst\ShogunBundle\Twig\ShDefineClasses" public="true">
            <tag name="twig.extension"/>
        </service>
    </services>
</container>