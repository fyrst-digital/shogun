export default "{% block shogun_benefits_settings %}\n    <div>\n    \n        <sw-container \n            columns=\"1fr 2fr auto\" \n            gap=\"0 1rem\" \n            style=\"align-items:flex-start;\">\n            \n            <template \n                v-if=\"selection.length > 0\" \n                v-for=\"(item, index) of selection\">\n\n                <sw-text-field\n                    v-model=\"item.icon\" />\n\n                <sw-text-field\n                    v-model=\"item.text\" />\n\n                <sw-button\n                    size=\"large\"\n                    :block=\"true\"\n                    @click=\"removeItem(index)\">\n                    {{ $tc('shogun.benefits.remove') }}\n                </sw-button>\n            </template>\n\n            <sw-text-field\n                v-model=\"newItem.icon\"\n                :placeholder=\"$tc('shogun.benefits.icon')\" />\n\n            <sw-text-field\n                v-model=\"newItem.text\" \n                :placeholder=\"$tc('shogun.benefits.description')\" \n                :class=\"[newItem.error ? 'has--error' : null]\" />\n\n\n            <sw-button\n                variant=\"primary\"\n                size=\"large\"\n                :block=\"true\"\n                @click=\"addItem(newItem)\">\n                {{ $tc('shogun.benefits.add') }}\n            </sw-button>\n\n        </sw-container>\n    </div>\n{% endblock %}";