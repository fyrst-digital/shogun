export default "{% block shogun_benefits_settings %}\n    <sw-page>\n\n        <template #smart-bar-header>\n            <h2>\n                {{ $tc('sw-settings.index.title') }}\n                <sw-icon\n                    name=\"regular-chevron-right-xs\"\n                    small\n                />\n                {{ $tc('shogun.uspbarModule') }}\n            </h2>\n        </template>\n\n        \n\n        <template #smart-bar-actions>\n            <sw-button\n                variant=\"primary\"\n                class=\"sw-extension-config__save-action\"\n                @click.prevent=\"onSave\"\n            >\n                {{ $tc('global.default.save') }}\n            </sw-button>\n        </template>\n\n        <template slot=\"content\">\n            <sw-card-view>\n                <sw-system-config\n                    ref=\"systemConfig\"\n                    sales-channel-switchable\n                    domain=\"ShogunBundle.benefits\"\n                    />\n            </sw-card-view>\n        </template>\n    </sw-page>\n{% endblock %}";