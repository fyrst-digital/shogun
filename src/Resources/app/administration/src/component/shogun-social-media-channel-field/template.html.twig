{% block shogun_benefits_settings %}
    <div>
        <!--
            <h4 :style="{
                display: 'flex',
                gap: '12px',
                alignItems: 'center',
                marginBottom: '10px'
            }">
                <sw-icon 
                    name="regular-facebook" 
                    size="16px" />
                Channel Name
            </h4>
        -->
            
        <sw-container columns="1fr 200px 200px" gap="0 16px">

            <sw-text-field
                :label="$tc('shogun.socialMedia.urlLabel')"
                :placeholder="$tc('shogun.socialMedia.urlPlaceholder')"
                v-model="channel.url"
                />
            
            <sw-number-field 
                numberType="int" 
                :label="$tc('shogun.socialMedia.positionLabel')"
                :step="1" 
                :min="1"
                :allowEmpty="false" 
                :placeholder="$tc('shogun.socialMedia.positionPlaceholder')"
                v-model="channel.position"
                />
                
            <sw-text-field
                :label="$tc('shogun.socialMedia.iconLabel')"
                :placeholder="$tc('shogun.socialMedia.iconPlaceholder')"
                v-model="channel.icon"
                />
        </sw-container>
    </div>
{% endblock %}
