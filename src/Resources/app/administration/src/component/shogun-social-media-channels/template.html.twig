{% block shogun_benefits_settings %}
    <div>
        <div v-for="[channel, options] of Object.entries(channelList)">
            <h4 :style="{
                display: 'flex',
                gap: '12px',
                alignItems: 'center',
                marginBottom: '10px'
            }">
                <sw-icon 
                    :name="`regular-${channel}`" 
                    size="16px" />
                {{label(channel)}}
            </h4>
            
            <sw-container columns="1fr 200px" gap="0 16px">
                <sw-text-field
                    :label="$tc('shogun.socialMedia.urlLabel')"
                    :placeholder="$tc('shogun.socialMedia.urlPlaceholder')"
                    :value="channelList[channel].url"
                    @input="value => set('url', channel, value)"
                    />

                <sw-number-field 
                    numberType="int" 
                    :label="$tc('shogun.socialMedia.positionLabel')"
                    :step="1" 
                    :min="1"
                    :value="channelList[channel].position" 
                    :allowEmpty="false" 
                    @change="value => set('position', channel, value)"
                    @input="value => set('position', channel, value)"/>
            </sw-container>
        </div>
    </div>
{% endblock %}