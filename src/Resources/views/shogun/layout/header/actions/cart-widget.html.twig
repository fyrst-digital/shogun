{% extends '@Storefront/storefront/layout/header/actions/cart-widget.html.twig' %}

{% block layout_header_actions_cart_widget %}
    {% block layout_header_actions_cart_widget_icon %}
        <span class="header-action-icon header-cart-icon">
            {% block layout_header_actions_cart_widget_icon_element %}
                {% sw_icon 'shopping-cart-simple' style {
                    'namespace': 'ShogunBundle',
                    'pack': 'phosphor'
                } %}
            {% endblock %}
            {% block layout_header_actions_cart_widget_badge %}
                {% if page.cart.lineItems|length > 0 %}
                    <span class="badge badge-sm bg-primary header-action-badge header-cart-badge">{{ page.cart.lineItems|length }}</span>
                {% endif %}
            {% endblock %}
        </span>
    {% endblock %}
    {% block layout_header_actions_cart_widget_label %}
        <span class="header-action-label">
            {{ 'checkout.cartTitle'|trans|striptags }}
        </span>
    {% endblock %}
{% endblock %}