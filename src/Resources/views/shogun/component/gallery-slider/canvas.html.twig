{% block shogun_component_gallery_slider_canvas %}
    <div class="gallery-slider-canvas-container position-relative">

        <div class="gallery-slider-canvas splide">

            {% if medias|length > 1 %}
                <div class="splide__arrows">
                    <button class="slider-control-button control-prev splide__arrow splide__arrow--prev">
                        {{sh_icon('caret-left')}}
                    </button>
                    <button class="slider-control-button control-next splide__arrow splide__arrow--next">
                        {{sh_icon('caret-right')}}
                    </button>
                </div>
            {% endif %}

            <div class="splide__track">
                <ul class="splide__list">
                    {% for media in medias %}
                        <li class="gallery-slider-canvas-item splide__slide">
                            {% sw_thumbnails 'gallery-slider-canvas-image' with {
                                media: media,
                                attributes: {
                                    class: 'gallery-slider-canvas-image'
                                }
                            } %}
                        </li>
                    {% endfor %}
                </ul>
            </div>

        </div>

    </div>
{% endblock %}