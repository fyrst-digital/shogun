{% block shogun_component_search_suggest %}
    <div class="position-absolute top-100 start-50 translate-middle-x p-4 search-suggest js-search-result">
        {% block shogun_component_suggest_container %}
            <ul class="search-suggest-container d-flex gap-3 flex-wrap bg-white p-3 border border-1 rounded-3 shadow-lg">
                {% block shogun_component_suggest_results %}
                    {% for product in page.searchResult %}
                        {% block shogun_component_suggest_result_product %}
                            {% sw_include '@Storefront/shogun/component/search/suggest-item.html.twig' %}
                        {% endblock %}
                    {% endfor %}
                {% endblock %}

                {% block shogun_component_suggest_result_total %}
                    {% sw_include '@Storefront/shogun/component/search/suggest-summary.html.twig' %}
                {% endblock %}
            </ul>
        {% endblock %}
    </div>
{% endblock %}