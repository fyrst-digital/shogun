{% block shogun_component_newsletter_subsription %}
    
    {% set subsribeUrl = null %}

    {% if config('ShogunBundle.newsletter.newsletterLandingpage') %}
        {% set subsribeUrl = seoUrl('frontend.landing.page', { landingPageId: config('ShogunBundle.newsletter.newsletterLandingpage') }) %}
    {% endif %}

    {% block shogun_component_newsletter_subsription_form %}
        <form 
            action="{{subsribeUrl}}"
            method="GET"
            data-form-validation="true"
            novalidate
            class="newletter-subscribe-form">

            <div class="input-group">
                {% block shogun_component_newsletter_subsription_form_input %}
                    <input 
                        type="email" 
                        name="email" 
                        required
                        class="form-control newletter-subscribe-form-input" 
                        placeholder="{{ "footer.newsletterInput"|trans|striptags }}" 
                        aria-label="{{ "footer.newsletterInput"|trans|striptags }}" />
                {% endblock %}
                {% block shogun_component_newsletter_subsription_form_button %}
                    <button 
                        class="btn btn-primary newletter-subscribe-form-button" 
                        type="submit">
                        {% block shogun_component_newsletter_subsription_form_button_inner %}{{ 'newsletter.formSubmit'|trans }}{% endblock %}
                    </button>
                {% endblock %}
            </div>

            {% block shogun_component_newsletter_subsription_privacy_include %}
                {% sw_include '@Storefront/shogun/component/newsletter/privacy-notice.html.twig' %}
            {% endblock %}
        </form>
    {% endblock %}

{% endblock %}
