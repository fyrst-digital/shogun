{% extends '@ShogunBundle/shogun/component/footer/_column.html.twig' %}

{% block shogun_component_footer_column_headline_title %}
    {% if root.category.type == 'folder' %}
        {{ root.category.translated.name }}
    {% else %}
        <a href="{{ category_url(root.category) }}"
            {% if category_linknewtab(root.category) %}target="_blank"{% endif %}
            title="{{ root.category.translated.name }}">
            {{ root.category.translated.name }}
        </a>
    {% endif %}
{% endblock %}

{% block shogun_component_footer_column_content %}

    {% block shogun_component_footer_colum_navigation_list %}
        <ul class="list-unstyled footer-navigation-list">
            {% for treeItem in root.children %}
                {% set category = treeItem.category %}
                {% set name = category.translated.name %}

                {% block shogun_component_footer_colum_navigation_item %}
                    <li class="footer-link-item">
                        {% if category.type == 'folder' %}
                            {% block shogun_component_footer_colum_navigation_display %}
                                <span>{{ name }}</span>
                            {% endblock %}
                        {% else %}
                            {% block shogun_component_footer_colum_navigation_link %}
                                <a class="footer-link"
                                    href="{{ category_url(category) }}"
                                    {% if category_linknewtab(category) %}target="_blank"{% endif %}
                                    title="{{ name }}">
                                    {{ name }}
                                </a>
                            {% endblock %}
                        {% endif %}
                    </li>
                {% endblock %}
            {% endfor %}
        </ul>
    {% endblock %}
{% endblock %}