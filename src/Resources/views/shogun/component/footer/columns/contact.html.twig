{% extends '@ShogunBundle/shogun/component/footer/_column.html.twig' %}

{% block shogun_component_footer_column_headline_title %}
    {{ "footer.column.contact.title" | trans }}
{% endblock %}

{% block shogun_component_footer_column_content %}
    {% if iconPack is not defined %}
        {% set iconPack = 'phosphor' %}
    {% endif %}

    {% if iconNamespace is not defined %}
        {% set iconNamespace = 'ShogunBundle' %}
    {% endif %}

    {% block shogun_component_footer_column_contact_address %}
        {% set shopAddress = config('core.basicInformation.address') %}

        {% block shogun_component_footer_column_contact_address_element %}
            <address>
                {{shopAddress|raw}}
            </address>
        {% endblock %}
    {% endblock %}

    {% block shogun_component_footer_column_contact_channels %}
        {% set shopContactChannels = {
            phone: {
                icon: 'phone',
                label: '+41 (0)62 893 05 02',
                url: null
            },
            mail: {
                icon: 'envelope-simple',
                label: '+41 (0)62 893 05 02',
                url: null
            }
        } %}

        {% set itemElement = 'div' %}

        {% block shogun_component_footer_column_contact_channels_element %}
            {% if shopContactChannels|length > 0 %}
                <ul class="contact-channels">
                    {% for key, item in shopContactChannels %}
                        {% block shogun_component_footer_column_contact_channel %}
                            <li>
                                <{{itemElement|raw}}
                                    class="contact-channel">

                                    {% block shogun_component_footer_column_contact_channel_icon %}
                                        {% sw_include '@Storefront/storefront/utilities/icon.html.twig' with {
                                            'name': item.icon,
                                            'pack': iconPack,
                                            'namespace': iconNamespace
                                        } %}
                                    {% endblock %}
                                    {% block shogun_component_footer_column_contact_channel_label %}
                                        {{item.label}}
                                    {% endblock %}
                                </{{itemElement|raw}}>
                            </li>
                        {% endblock %}
                    {% endfor %}
                </ul>
            {% endif %}
        {% endblock %}
    {% endblock %}
{% endblock %}