{% block shogun_component_footer_column %}
    <div class="{% block shogun_component_footer_column_classes %}footer-column{% if columnClasses|length > 0 %} {{ columnClasses|join(' ') }}{% endif %}{% endblock %}">
        {% block shogun_component_footer_column_inner %}

            {% block shogun_component_footer_column_headline %}
                <div class="footer-column-headline footer-headline"
                    role="listitem">

                    {% block shogun_component_footer_column_headline_title %}
                    {% endblock %}
                </div>
            {% endblock %}

            {% block shogun_component_footer_column_content_container %}
                <div class="footer-column-content-container">

                    {% block shogun_component_footer_column_content %}
                    {% endblock %}
                </div>
            {% endblock %}
        {% endblock %}
    </div>
{% endblock %}