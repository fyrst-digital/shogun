{% if paymentMethods is not defined %}
    {% set paymentMethods = page.salesChannelPaymentMethods %}
{% endif %}

{% if thumbnailSize is not defined %}
    {% set thumbnailSize = {
        default: '100px'
    } %}
{% endif %}

{% block component_payment_logos %}
    <div class="method-logos payment-logos">
        {% for paymentMethod in paymentMethods %}
            {% block component_payment_payment_logo %}
                {% if paymentMethod.media %}
                    <div class="method-logo payment-logo">
                        {% sw_thumbnails 'payment-logo-thumbnails' with {
                            media: paymentMethod.media,
                            sizes: thumbnailSize,
                            attributes: {
                                class: 'img-fluid method-logo-image payment-logo-image',
                                alt: (paymentMethod.media.translated.alt ?: paymentMethod.translated.name),
                                title: (paymentMethod.media.translated.title ?: paymentMethod.translated.name)
                            }
                        } %}
                    </div>
                {% endif %}
            {% endblock %}
        {% endfor %}
    </div>
{% endblock %}