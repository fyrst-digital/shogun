{% extends '@Storefront/storefront/component/line-item/element/quantity.html.twig' %}

{% block component_line_item_quantity_inner %}
    {% block component_line_item_quantity_label %}
        {{ parent() }}
    {% endblock %}

    {% block component_line_item_quantity_select_wrapper %}
        {{ parent() }}
    {% endblock %}

    {% block component_line_item_type_product_col_remove %}
        {% if showRemoveButton %}
            {% if lineItem.removable and nestingLevel < 1 %}
                {% sw_include '@Storefront/storefront/component/line-item/element/remove.html.twig' with {
                    formAction: path('frontend.checkout.line-item.delete', { id: lineItem.id })
                } %}
            {% endif %}
        {% endif %}
    {% endblock %}
{% endblock %}

{% block component_line_item_quantity_display %}
    {{ lineItem.quantity }}
{% endblock %}