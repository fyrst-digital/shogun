{% extends '@Storefront/storefront/component/line-item/element/remove.html.twig' %}

{% block component_line_item_remove_button %}
    <button type="submit"
            title="{{ "checkout.removeLineItem"|trans|striptags }}"
            data-product-id="{{ lineItem.id }}"
            class="btn btn-link line-item-remove-button">
        {% block component_line_item_remove_button_icon %}
            {% sw_icon 'trash' style {
                'namespace': 'ShogunBundle',
                'pack': 'phosphor'
            } %}
        {% endblock %}
    </button>
{% endblock %}