{% set defaultClasses = {
    button: ['btn', 'cart-action-btn']
} %}

{% if classes is defined %}
    {% set classes = defaultClasses|sh_merge_deep(classes) %}
{% else %}
    {% set classes = defaultClasses %}
{% endif %}

{% block shogun_component_cart_action %}
    <a class="{{ classes.button|join(' ') }}"
        href="{{ path('frontend.checkout.cart.page') }}"
        data-cart-widget="true"
        data-off-canvas-cart="true"
        title="{{ 'checkout.cartTitle'|trans|striptags }}"
        aria-label="{{ 'checkout.cartTitle'|trans|striptags }}">
        
        {% block shogun_component_cart_action_widget %}
            {% sw_include '@Storefront/shogun/component/cart/cart-widget.html.twig' %}
        {% endblock %}
    </a>
{% endblock %}
